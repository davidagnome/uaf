<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    UAFedit is a WinExe; referencing it from a test project is what UAFedit.Tests and
    UAFedit.Map.Tests already do. Nothing here constructs a control — every test drives a view
    model — so no display, no Avalonia application and no headless platform is needed.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\UAFedit\UAFedit.csproj" />
  </ItemGroup>

</Project>
