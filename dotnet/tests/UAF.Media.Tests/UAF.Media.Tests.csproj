<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The SDL headless tests push events onto SDL's own queue, which takes an SDL_Event*. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The MP3 fixture. MP3 cannot be authored in a test the way WAV and MIDI can, so this one file
       is committed; it is a 440 Hz tone generated with the ffmpeg CLI, not design content. -->
  <ItemGroup>
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UAF.Media\UAF.Media.csproj" />
    <ProjectReference Include="..\..\src\UAF.Media.Sdl\UAF.Media.Sdl.csproj" />

    <!-- FrameCompositionTests is an integration test across both halves of the port: it reads a
         real design with UAF.Serialization and draws it with UAF.Media. Nothing else here needs
         serialization, and UAF.Media itself does not reference it. -->
    <ProjectReference Include="..\..\src\UAF.Serialization\UAF.Serialization.csproj" />
    <ProjectReference Include="..\..\src\UAF.Data\UAF.Data.csproj" />
  </ItemGroup>

</Project>
