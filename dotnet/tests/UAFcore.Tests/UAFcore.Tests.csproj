<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Golden viewport hashes. Generated from gitignored art, so a fresh checkout has none until
       someone runs UAF_GOLDEN_UPDATE=1; GoldenFrameTests treats absence as "nothing to check". -->
  <ItemGroup>
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UAFcore\UAFcore.csproj" />
    <!-- Explicit since the UAFcore.App split: the tests load real designs through the SDL
         image decoder and font rasteriser, and used to reach them transitively through UAFcore. -->
    <ProjectReference Include="..\..\src\UAF.Media.Sdl\UAF.Media.Sdl.csproj" />
    <!-- The FRUA import "loads in UAFcore" check imports a DOS design and opens the result. -->
    <ProjectReference Include="..\..\src\UAF.Import.Frua\UAF.Import.Frua.csproj" />
  </ItemGroup>

</Project>
