<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UAF.Rules\UAF.Rules.csproj" />

    <!-- LevellingTests reads real experience thresholds out of a design's baseclass.dat rather
         than restating them. UAF.Rules itself must not depend on the serializer (Levelling takes a
         plain list of thresholds precisely so it cannot), but proving the two halves fit is exactly
         what this test project is for. -->
    <ProjectReference Include="..\..\src\UAF.Serialization\UAF.Serialization.csproj" />
  </ItemGroup>

</Project>
