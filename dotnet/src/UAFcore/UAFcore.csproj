<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The engine, and the first thing in this port that is an application rather than a library.
    Named UAFcore rather than UAFWin because it is no longer Windows-exclusive.

    It is deliberately thin: Game holds the state machine and draws into a managed Surface, and
    knows nothing about SDL. Program wires a real window and input to it; the tests wire a headless
    presenter and a recorded input source to the same class. That split is what keeps the engine
    testable on a CI runner with no display, and it is the same discipline UAF.Media follows.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UAFcore</RootNamespace>
    <AssemblyName>UAFcore</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UAF.Data\UAF.Data.csproj" />
    <ProjectReference Include="..\UAF.Media\UAF.Media.csproj" />
    <ProjectReference Include="..\UAF.Media.Sdl\UAF.Media.Sdl.csproj" />
    <ProjectReference Include="..\UAF.Serialization\UAF.Serialization.csproj" />
  </ItemGroup>

</Project>
