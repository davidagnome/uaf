    <ComboBox x:Name="IDC_DISTANCE" Canvas.Left="189" Canvas.Top="13" Width="97" Height="22" /> <!-- CBS_DROPDOWN: the original accepted typed text; Avalonia's ComboBox does not -->
    <TextBlock Canvas.Left="3" Canvas.Top="47" Width="61" Height="13" Text="Player Hears" TextWrapping="Wrap" />
    <Button x:Name="IDC_SOUNDSELECT" Canvas.Left="70" Canvas.Top="42" Width="113" Height="23" Content="No Sound" />
    <CheckBox x:Name="IDC_FORCEBACKUP" Canvas.Left="7" Canvas.Top="78" Width="129" Height="16" Content="Backup party one step" />
    <CheckBox x:Name="IDC_KILLSOUND" Canvas.Left="183" Canvas.Top="81" Width="166" Height="16" Content="Stop sound when event ends." />
    <CheckBox x:Name="IDC_WAITFORRETURN" Canvas.Left="7" Canvas.Top="95" Width="149" Height="17" Content="User must press RETURN" />
    <CheckBox x:Name="IDC_HIGHLIGHTTEXT" Canvas.Left="7" Canvas.Top="115" Width="104" Height="16" Content="Highlight All Text" />
    <TextBlock Canvas.Left="9" Canvas.Top="134" Width="64" Height="13" Text="Player Reads" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TEXT" Canvas.Left="6" Canvas.Top="151" Width="412" Height="123" AcceptsReturn="True" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="282" Width="143" Height="13" Text="Special character sequences:" TextWrapping="Wrap" />
    <Button x:Name="IDOK" Canvas.Left="342" Canvas.Top="13" Width="75" Height="22" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="342" Canvas.Top="40" Width="75" Height="23" Content="Cancel" IsCancel="True" />
    <TextBlock Canvas.Left="10" Canvas.Top="295" Width="315" Height="13" Text="^ followed by digit '1' to '12' substitues character name (default = 1)" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="308" Width="81" Height="13" Text="^ followed by 'D' " TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="321" Width="83" Height="13" Text="^ followed by 'M' " TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="334" Width="81" Height="13" Text="^ followed by 'H' " TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="347" Width="393" Height="13" Text="^ followed by 'a'  to 'z' prints contents of global ASL  -  $SET_GLOBAL_ASL" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="360" Width="237" Height="13" Text="/ followed by 'w', 'r', 'y', 'b', 'g', or 'c' sets text color " TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="373" Width="162" Height="13" Text="/ followed by 'h'  Toggles highlight" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="386" Width="252" Height="13" Text="/ followed by 'n'  Waits for ENTER before proceeding" TextWrapping="Wrap" />
  </Canvas>
</UserControl>
