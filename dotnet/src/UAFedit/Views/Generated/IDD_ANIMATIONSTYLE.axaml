<!--
  IDD_ANIMATIONSTYLE — generated by tools/rc2axaml from src/UAFWinEd/UAFWinEd.rc:2497.
  CAPTION "Animation Settings"
  267 x 218 dialog units at FONT 8, "MS Sans Serif" (base units 6 x 13) = 400 x 354 px.

  Not hand-edited and not wired into a project: regenerate rather than patch, or move the
  file out of Views/Generated once a real view takes it over.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400" Height="354">
  <Canvas Width="400" Height="354">
    <RadioButton x:Name="IDC_DEFAULTANIM" Canvas.Left="12" Canvas.Top="13" Width="79" Height="16" Content="Sequenced" GroupName="IDD_ANIMATIONSTYLE_Group1" />
    <RadioButton x:Name="IDC_DIRECTIONALANIM" Canvas.Left="12" Canvas.Top="48" Width="73" Height="17" Content="Directional" GroupName="IDD_ANIMATIONSTYLE_Group1" />
    <TextBlock Canvas.Left="94" Canvas.Top="14" Width="192" Height="13" Text="Default, each frame is used in sequence" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="94" Canvas.Top="39" Width="294" Height="43" Text="(Item animations only) This style applies to sprites that orient themselves towards the target, such as arrows. Sprite has 8 frames, engine picks proper frame based on direction to target" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="37" Canvas.Top="92" Width="326" Height="15" Text="*** Alpha blending affects only combat animations. ***" TextAlignment="Center" TextWrapping="Wrap" />
    <CheckBox x:Name="IDC_USEALPHA" Canvas.Left="16" Canvas.Top="115" Width="210" Height="16" Content="Alpha-blend animation with background" />
    <TextBox x:Name="IDC_ALPHAVALUE" Canvas.Left="16" Canvas.Top="133" Width="60" Height="23" TextAlignment="Right" />
    <TextBlock Canvas.Left="81" Canvas.Top="138" Width="141" Height="13" Text="Level of alpha blending 0-255" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="16" Canvas.Top="157" Width="237" Height="42" Text="0 = animation totally covers background&#10;150 = decent translucency effect&#10;255 = animation barely visible against background" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="114" Canvas.Top="209" Width="174" Height="15" Text="*** Additional Animation Options ***" TextAlignment="Center" TextWrapping="Wrap" />
    <CheckBox x:Name="IDC_INPUTBEFORELOOP" Canvas.Left="15" Canvas.Top="229" Width="339" Height="16" Content="Wait for keypress before looping back to first frame (small pics only)" />
    <CheckBox x:Name="IDC_LIMITLOOPING" Canvas.Left="15" Canvas.Top="247" Width="220" Height="16" Content="Limit animation looping to this many loops:" />
    <TextBox x:Name="IDC_NUMLOOPS" Canvas.Left="235" Canvas.Top="245" Width="60" Height="23" />
    <CheckBox x:Name="IDC_LOOP" Canvas.Left="15" Canvas.Top="266" Width="96" Height="16" Content="Loop animation" />
    <TextBlock Canvas.Left="16" Canvas.Top="287" Width="368" Height="29" Text="Sequenced combat animations that travel, such as missile animations, will be automatically looped until the destination is reached" TextWrapping="Wrap" />
    <Button x:Name="IDOK" Canvas.Left="121" Canvas.Top="325" Width="75" Height="22" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="205" Canvas.Top="325" Width="75" Height="22" Content="Cancel" IsCancel="True" />
  </Canvas>
</UserControl>
