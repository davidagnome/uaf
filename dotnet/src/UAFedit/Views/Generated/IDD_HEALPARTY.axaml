  <Canvas Width="352" Height="258">
    <TextBlock Canvas.Left="6" Canvas.Top="8" Width="57" Height="14" Text="Player Sees" TextWrapping="Wrap" />
    <Button x:Name="IDC_SEECHAR" Canvas.Left="67" Canvas.Top="4" Width="113" Height="23" Content="Small Picture" />
    <TextBlock Canvas.Left="7" Canvas.Top="35" Width="65" Height="13" Text="Player Reads" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TEXT" Canvas.Left="7" Canvas.Top="53" Width="339" Height="68" AcceptsReturn="True" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="13" Canvas.Top="130" Width="102" Height="13" Text="What sort of healing?" TextWrapping="Wrap" />
    <CheckBox x:Name="IDC_HEALHP" Canvas.Left="18" Canvas.Top="152" Width="69" Height="17" Content="Hit Points" />
    <TextBox x:Name="IDC_HOWMUCHHP" Canvas.Left="90" Canvas.Top="151" Width="60" Height="19" />
    <RadioButton x:Name="IDC_LITERALORPERCENT" Canvas.Left="153" Canvas.Top="146" Width="165" Height="16" Content="Add value to current hit points" GroupName="IDD_HEALPARTY_Group3" />
    <RadioButton x:Name="IDC_LITERALORPERCENT2" Canvas.Left="153" Canvas.Top="160" Width="178" Height="17" Content="Add percentage of max hit points" GroupName="IDD_HEALPARTY_Group3" />
    <RadioButton x:Name="IDC_LITERALORPERCENT3" Canvas.Left="153" Canvas.Top="175" Width="187" Height="16" Content="Set to percentage of max hit points" GroupName="IDD_HEALPARTY_Group3" />
    <CheckBox x:Name="IDC_HEALCURSE" Canvas.Left="18" Canvas.Top="175" Width="94" Height="16" Content="Remove Curse" />
    <CheckBox x:Name="IDC_HEALDRAIN" Canvas.Left="18" Canvas.Top="191" Width="123" Height="17" Content="Restore Drain Levels" />
    <TextBlock Canvas.Left="49" Canvas.Top="211" Width="39" Height="13" Text="Apply to" TextWrapping="Wrap" />
    <ComboBox x:Name="IDC_HEALWHO" Canvas.Left="13" Canvas.Top="227" Width="125" Height="23" />
    <TextBox x:Name="IDC_CHANCE" Canvas.Left="145" Canvas.Top="225" Width="26" Height="23" />
    <TextBlock Canvas.Left="175" Canvas.Top="229" Width="48" Height="13" Text="% chance" TextWrapping="Wrap" />
    <Button x:Name="IDOK" Canvas.Left="267" Canvas.Top="196" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="267" Canvas.Top="227" Width="75" Height="23" Content="Cancel" IsCancel="True" />
