<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="565" Height="118">
  <Canvas Width="565" Height="118">
    <TextBlock Canvas.Left="3" Canvas.Top="8" Width="84" Height="13" Text="Attribute Affected" TextWrapping="Wrap" />
    <ComboBox x:Name="IDC_ATTNAME" Canvas.Left="90" Canvas.Top="3" Width="240" Height="23" />
    <TextBlock Canvas.Left="333" Canvas.Top="6" Width="112" Height="13" Text="(ie: what gets changed)" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="33" Canvas.Top="40" Width="54" Height="13" Text="Change By" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_CHANGEMADETEXT" Canvas.Left="90" Canvas.Top="35" Width="162" Height="23" />
    <RadioButton x:Name="IDC_CHANGEDELTA" Canvas.Left="256" Canvas.Top="27" Width="153" Height="16" Content="Delta (add to current value)" GroupName="IDD_SPELLATTRIBUTEEDIT_Group2" />
    <RadioButton x:Name="IDC_CHANGEPCNT" Canvas.Left="256" Canvas.Top="42" Width="197" Height="16" Content="Percent (set to pcnt of current value)" GroupName="IDD_SPELLATTRIBUTEEDIT_Group2" />
    <RadioButton x:Name="IDC_CHANGEABSOLUTE" Canvas.Left="256" Canvas.Top="56" Width="206" Height="17" Content="Absolute (change current to this value)" GroupName="IDD_SPELLATTRIBUTEEDIT_Group2" />
    <RadioButton x:Name="IDC_CHANGEREMOVEALL" Canvas.Left="256" Canvas.Top="71" Width="101" Height="16" Content="Remove if exists" GroupName="IDD_SPELLATTRIBUTEEDIT_Group2" />
    <TextBlock Canvas.Left="27" Canvas.Top="76" Width="60" Height="13" Text="Affects Who" TextWrapping="Wrap" />
    <CheckBox x:Name="IDC_AFFECTSTARGET" Canvas.Left="90" Canvas.Top="76" Width="55" Height="16" Content="Target" />
    <CheckBox x:Name="IDC_AFFECTSTARGETER" Canvas.Left="157" Canvas.Top="76" Width="65" Height="16" Content="Targeter" />
    <CheckBox x:Name="IDC_CUMULATIVE" Canvas.Left="27" Canvas.Top="99" Width="265" Height="16" Content="Cumulative with other actions affecting this attribute" />
    <Button x:Name="IDC_ROLLDICE" Canvas.Left="322" Canvas.Top="87" Width="95" Height="23" Content="Debug Dice Roll" />
    <Button x:Name="IDC_EDITSCRIPTS" Canvas.Left="477" Canvas.Top="6" Width="75" Height="23" Content="Edit Scripts" />
    <Button x:Name="IDOK" Canvas.Left="477" Canvas.Top="50" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="477" Canvas.Top="79" Width="75" Height="23" Content="Cancel" IsCancel="True" />
  </Canvas>
</UserControl>
