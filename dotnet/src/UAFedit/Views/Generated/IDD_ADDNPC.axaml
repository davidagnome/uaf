<!--
  IDD_ADDNPC — generated by tools/rc2axaml from src/UAFWinEd/UAFWinEd.rc:505.
  CAPTION "Add NPC"
  274 x 122 dialog units at FONT 8, "MS Sans Serif" (base units 6 x 13) = 411 x 198 px.

  Not hand-edited and not wired into a project: regenerate rather than patch, or move the
  file out of Views/Generated once a real view takes it over.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="411" Height="198">
  <Canvas Width="411" Height="198">
    <TextBox x:Name="IDC_TEXT" Canvas.Left="10" Canvas.Top="71" Width="390" Height="89" AcceptsReturn="True" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="14" Width="57" Height="15" Text="Player Sees" TextWrapping="Wrap" />
    <Button x:Name="IDC_SEECHAR" Canvas.Left="75" Canvas.Top="9" Width="112" Height="23" Content="Small Picture" />
    <ComboBox x:Name="IDC_DISTANCE" Canvas.Left="196" Canvas.Top="11" Width="98" Height="23" /> <!-- CBS_DROPDOWN: the original accepted typed text; Avalonia's ComboBox does not -->
    <TextBlock Canvas.Left="10" Canvas.Top="53" Width="71" Height="16" Text="Player Reads" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="175" Width="51" Height="15" Text="Add NPC" TextWrapping="Wrap" />
    <Button x:Name="IDC_ADDCHAR" Canvas.Left="60" Canvas.Top="170" Width="112" Height="23" Content="Nobody" />
    <TextBlock Canvas.Left="177" Canvas.Top="173" Width="25" Height="15" Text="with" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_PCNTHITPOINTS" Canvas.Left="202" Canvas.Top="170" Width="29" Height="21" />
    <TextBlock Canvas.Left="235" Canvas.Top="173" Width="71" Height="17" Text="% of hit points" TextWrapping="Wrap" />
    <Button x:Name="IDOK" Canvas.Left="322" Canvas.Top="11" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="322" Canvas.Top="39" Width="75" Height="22" Content="Cancel" IsCancel="True" />
    <CheckBox x:Name="IDC_USEORIGINAL" Canvas.Left="190" Canvas.Top="43" Width="104" Height="17" Content="Add original NPC" />
  </Canvas>
</UserControl>
