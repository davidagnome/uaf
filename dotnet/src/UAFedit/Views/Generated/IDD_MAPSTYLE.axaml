-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="336" Height="341">
  <Canvas Width="336" Height="341">
    <TextBlock Canvas.Left="7" Canvas.Top="11" Width="30" Height="13" Text="Name" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_MAPNAME" Canvas.Left="40" Canvas.Top="6" Width="230" Height="23" />
    <RadioButton x:Name="IDC_DUNGEON" Canvas.Left="3" Canvas.Top="35" Width="67" Height="17" Content="Dungeon" GroupName="IDD_MAPSTYLE_Group1" />
    <RadioButton x:Name="IDC_OVERLAND" Canvas.Left="3" Canvas.Top="58" Width="76" Height="16" Content="Wilderness" GroupName="IDD_MAPSTYLE_Group1" />
    <CheckBox x:Name="IDC_USEDEFBG" Canvas.Left="96" Canvas.Top="35" Width="156" Height="17" Content="Fill with Default Background" />
    <TextBlock Canvas.Left="96" Canvas.Top="60" Width="60" Height="13" Text="Background" TextWrapping="Wrap" />
    <Button x:Name="IDC_LOADOVERLANDMAP" Canvas.Left="160" Canvas.Top="55" Width="113" Height="23" Content="None" />
    <TextBlock x:Name="IDC_WIDTHTEXT" Canvas.Left="156" Canvas.Top="91" Width="72" Height="13" Text="Width (10-100)" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_MAPWIDTH" Canvas.Left="234" Canvas.Top="86" Width="52" Height="22" />
    <TextBlock x:Name="IDC_HEIGHTTEXT" Canvas.Left="153" Canvas.Top="115" Width="75" Height="13" Text="Height (10-100)" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_MAPHEIGHT" Canvas.Left="234" Canvas.Top="110" Width="52" Height="23" />
    <Button x:Name="IDOK" Canvas.Left="130" Canvas.Top="313" Width="75" Height="23" Content="Close" IsDefault="True" />
    <ComboBox x:Name="IDC_AVStyleList" Canvas.Left="4" Canvas.Top="95" Width="137" Height="23" />
    <TextBlock Canvas.Left="27" Canvas.Top="82" Width="82" Height="13" Text="View Restrictions" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="121" Width="129" Height="28" Text="These restrictions will override the zone settings" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="152" Width="144" Height="13" Text="Area/3D is for Dungeon Maps" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="167" Width="168" Height="13" Text="Large/Small is for Wilderness Maps" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="6" Canvas.Top="201" Width="57" Height="13" Text="Step Sound" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="6" Canvas.Top="250" Width="63" Height="13" Text="Bump Sound" TextWrapping="Wrap" />
    <Button x:Name="IDC_STEPSOUND" Canvas.Left="69" Canvas.Top="198" Width="105" Height="23" Content="None" />
    <Button x:Name="IDC_BUMPSOUND" Canvas.Left="69" Canvas.Top="243" Width="105" Height="23" Content="None" />
    <Button x:Name="IDC_BACKGROUNDSOUNDS" Canvas.Left="189" Canvas.Top="143" Width="105" Height="22" Content="Background Music" />
    <CheckBox x:Name="IDC_USENIGHTSOUNDS" Canvas.Left="184" Canvas.Top="199" Width="132" Height="25" Content="Play night sounds during this time" />
    <TextBox x:Name="IDC_NIGHTTIMESTART" Canvas.Left="184" Canvas.Top="229" Width="45" Height="19" TextAlignment="Right" />
    <TextBlock Canvas.Left="232" Canvas.Top="232" Width="50" Height="13" Text="Start Time" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_NIGHTTIMEEND" Canvas.Left="184" Canvas.Top="251" Width="45" Height="20" TextAlignment="Right" />
    <TextBlock Canvas.Left="232" Canvas.Top="256" Width="47" Height="13" Text="End Time" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="181" Canvas.Top="276" Width="65" Height="27" Text="Use 24 Hour Format" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="265" Canvas.Top="276" Width="63" Height="13" Text="0 = 12:00 am" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="247" Canvas.Top="292" Width="81" Height="13" Text="2359 = 11:59 pm" TextWrapping="Wrap" />
    <Button x:Name="IDC_NIGHTSOUNDS" Canvas.Left="189" Canvas.Top="170" Width="105" Height="23" Content="Night Music" />
    <CheckBox x:Name="IDC_SupressStepSound" Canvas.Left="6" Canvas.Top="221" Width="121" Height="16" Content="Supress Step Sound" />
    <CheckBox x:Name="IDC_SupressBumpSound" Canvas.Left="6" Canvas.Top="268" Width="126" Height="16" Content="Supress Bump Sound" />
  </Canvas>
</UserControl>
