<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="337" Height="404">
  <Canvas Width="337" Height="404">
    <Button x:Name="IDOK" Canvas.Left="190" Canvas.Top="295" Width="68" Height="23" Content="OK" />
    <Button x:Name="IDCANCEL" Canvas.Left="264" Canvas.Top="295" Width="67" Height="23" Content="Cancel" IsDefault="True" IsCancel="True" />
    <Border x:Name="IDC_SmallPicture2" Canvas.Left="3" Canvas.Top="4" Width="175" Height="212" BorderBrush="Gray" BorderThickness="1" />
    <TextBlock Canvas.Left="16" Canvas.Top="258" Width="26" Height="13" Text="Load" TextWrapping="Wrap" />
    <Button x:Name="IDC_SELECTFILE" Canvas.Left="48" Canvas.Top="253" Width="112" Height="23" Content="Load Pic" />
    <Button x:Name="IDC_CLEARPIC" Canvas.Left="64" Canvas.Top="282" Width="75" Height="23" Content="Clear Pic" />
    <TextBlock Canvas.Left="195" Canvas.Top="8" Width="61" Height="13" Text="Frame Width" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_FWIDTH" Canvas.Left="261" Canvas.Top="3" Width="48" Height="23" />
    <TextBlock Canvas.Left="192" Canvas.Top="30" Width="64" Height="13" Text="Frame Height" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_FHEIGHT" Canvas.Left="261" Canvas.Top="26" Width="48" Height="22" />
    <TextBlock Canvas.Left="196" Canvas.Top="53" Width="60" Height="13" Text="Num Frames" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_NUMFRAMES" Canvas.Left="261" Canvas.Top="48" Width="48" Height="23" />
    <TextBlock Canvas.Left="192" Canvas.Top="76" Width="105" Height="13" Text="Restart frame" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_RESTARTFRAME" Canvas.Left="261" Canvas.Top="71" Width="48" Height="23" />
    <TextBlock Canvas.Left="195" Canvas.Top="110" Width="124" Height="29" Text="Millisecs between frames (0=None, else min = 30)" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_DELAY" Canvas.Left="240" Canvas.Top="139" Width="33" Height="20" TextAlignment="Right" />
    <Button x:Name="IDC_UPDATESTATS" Canvas.Left="205" Canvas.Top="169" Width="105" Height="22" Content="Update Frame Data" />
    <Button x:Name="IDC_VIEWALLPIC" Canvas.Left="205" Canvas.Top="196" Width="105" Height="23" Content="View Entire Pic" />
    <Button x:Name="IDC_ANIMATIONSTYLE" Canvas.Left="205" Canvas.Top="224" Width="105" Height="23" Content="Animation Style" />
    <Button x:Name="IDC_TOGGLEANIM" Canvas.Left="190" Canvas.Top="256" Width="68" Height="23" Content="Start" />
