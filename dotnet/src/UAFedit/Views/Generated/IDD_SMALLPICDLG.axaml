    <TextBlock Canvas.Left="3" Canvas.Top="342" Width="328" Height="28" Text="All multi-frame images must order the frames from left to right in a single row." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="3" Canvas.Top="372" Width="232" Height="13" Text="Combat pics typically have a frame size of 48x48." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="3" Canvas.Top="390" Width="234" Height="13" Text="Small pics typically have a frame size of 176x211." TextWrapping="Wrap" />
  </Canvas>
