<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="387" Height="224">
  <Canvas Width="387" Height="224">
    <Button x:Name="IDOK" Canvas.Left="114" Canvas.Top="193" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="198" Canvas.Top="193" Width="75" Height="23" Content="Cancel" IsCancel="True" />
    <TextBlock Canvas.Left="4" Canvas.Top="13" Width="57" Height="13" Text="Player sees" TextWrapping="Wrap" />
    <Button x:Name="IDC_CHOOSEART" Canvas.Left="66" Canvas.Top="8" Width="112" Height="22" Content="Small Picture" />
    <TextBlock Canvas.Left="4" Canvas.Top="39" Width="62" Height="13" Text="Player reads" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TEXT" Canvas.Left="3" Canvas.Top="55" Width="378" Height="57" AcceptsReturn="True" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="121" Width="62" Height="13" Text="Days (0-250)" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_PASSDAYS" Canvas.Left="78" Canvas.Top="117" Width="25" Height="22" />
    <TextBlock Canvas.Left="12" Canvas.Top="146" Width="60" Height="13" Text="Hours (0-23)" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_PASSHOURS" Canvas.Left="78" Canvas.Top="141" Width="25" Height="23" />
    <TextBlock Canvas.Left="3" Canvas.Top="170" Width="69" Height="13" Text="Minutes (0-59)" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_PASSMINUTES" Canvas.Left="78" Canvas.Top="165" Width="25" Height="23" />
    <CheckBox x:Name="IDC_ALLOWEXIT" Canvas.Left="127" Canvas.Top="118" Width="194" Height="16" Content="Allow player to interrupt passing time" />
    <CheckBox x:Name="IDC_SILENTPASSING" Canvas.Left="127" Canvas.Top="141" Width="251" Height="16" Content="Increment clock instantly (no visible countdown)" />
    <CheckBox x:Name="IDC_SETTIME" Canvas.Left="127" Canvas.Top="157" Width="171" Height="28" Content="Set game clock to these values (no countdown, forward only)" />
  </Canvas>
</UserControl>
