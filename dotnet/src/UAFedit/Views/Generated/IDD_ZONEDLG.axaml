-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="412" Height="401">
  <Canvas Width="412" Height="401">
    <TextBox x:Name="IDC_ZONENAME" Canvas.Left="78" Canvas.Top="3" Width="238" Height="21" />
    <Border x:Name="IDC_ZONECOLOR" Canvas.Left="321" Canvas.Top="6" Width="12" Height="13" BorderBrush="Gray" BorderThickness="1" />
    <TextBlock Canvas.Left="150" Canvas.Top="29" Width="114" Height="13" Text="Zone Message on Entry" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_ZONEMSG" Canvas.Left="4" Canvas.Top="43" Width="402" Height="62" AcceptsReturn="True" TextWrapping="Wrap" />
    <RadioButton x:Name="IDC_ALLOWAREAMAP" Canvas.Left="75" Canvas.Top="108" Width="97" Height="17" Content="Allow Area Map" GroupName="IDD_ZONEDLG_Group3" />
    <RadioButton x:Name="IDC_ALLOWAUTOMAP" Canvas.Left="178" Canvas.Top="108" Width="98" Height="17" Content="Allow Auto Map" GroupName="IDD_ZONEDLG_Group3" />
    <RadioButton x:Name="IDC_NOMAP" Canvas.Left="277" Canvas.Top="108" Width="62" Height="17" Content="No Map" GroupName="IDD_ZONEDLG_Group3" />
    <TextBlock Canvas.Left="0" Canvas.Top="130" Width="100" Height="27" Text="Summoned Monster&#10;Not used!" TextAlignment="Right" TextWrapping="Wrap" />
    <Button x:Name="IDC_SUMMONEDMONSTER" Canvas.Left="103" Canvas.Top="130" Width="113" Height="22" Content="Summoned Monster" />
    <TextBlock Canvas.Left="13" Canvas.Top="160" Width="87" Height="13" Text="Indoor Combat Art" TextWrapping="Wrap" />
    <Button x:Name="IDC_INDOORCOMBAT" Canvas.Left="103" Canvas.Top="156" Width="113" Height="22" Content="Indoor Combat Art" />
    <TextBlock Canvas.Left="6" Canvas.Top="186" Width="94" Height="13" Text="Outdoor Combat Art" TextWrapping="Wrap" />
    <Button x:Name="IDC_OUTDOORCOMBAT" Canvas.Left="103" Canvas.Top="182" Width="113" Height="22" Content="Outdoor Combat Art" />
    <TextBlock Canvas.Left="55" Canvas.Top="212" Width="45" Height="13" Text="Camp Art" TextWrapping="Wrap" />
    <Button x:Name="IDC_CAMPART" Canvas.Left="103" Canvas.Top="208" Width="113" Height="22" Content="Camp Art" />
    <TextBlock Canvas.Left="40" Canvas.Top="238" Width="60" Height="13" Text="Treasure Art" TextWrapping="Wrap" />
    <Button x:Name="IDC_TREASUREART" Canvas.Left="103" Canvas.Top="234" Width="113" Height="22" Content="Treasure Art" />
    <TextBlock Canvas.Left="276" Canvas.Top="351" Width="124" Height="13" Text="Area View Art for all zones" TextWrapping="Wrap" />
    <Button x:Name="IDC_AVART" Canvas.Left="282" Canvas.Top="321" Width="112" Height="23" Content="Area View Art" />
    <CheckBox x:Name="IDC_USENIGHTSOUNDS" Canvas.Left="228" Canvas.Top="131" Width="180" Height="16" Content="Play night sounds during this time" />
    <TextBox x:Name="IDC_NIGHTTIMESTART" Canvas.Left="228" Canvas.Top="152" Width="45" Height="20" TextAlignment="Right" />
    <TextBlock Canvas.Left="276" Canvas.Top="156" Width="49" Height="13" Text="Start Time" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_NIGHTTIMEEND" Canvas.Left="228" Canvas.Top="175" Width="45" Height="20" TextAlignment="Right" />
    <TextBlock Canvas.Left="276" Canvas.Top="178" Width="46" Height="13" Text="End Time" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="225" Canvas.Top="199" Width="64" Height="28" Text="Use 24 Hour Format" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="315" Canvas.Top="199" Width="63" Height="13" Text="0 = 12:00 am" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="297" Canvas.Top="216" Width="81" Height="13" Text="2359 = 11:59 pm" TextWrapping="Wrap" />
    <Button x:Name="IDC_NIGHTSOUNDS" Canvas.Left="246" Canvas.Top="234" Width="105" Height="22" Content="Night Music" />
    <Button x:Name="IDC_BACKGROUNDSOUNDS" Canvas.Left="246" Canvas.Top="261" Width="105" Height="23" Content="Background Music" />
    <TextBlock Canvas.Left="24" Canvas.Top="268" Width="159" Height="13" Text="Added Turning Difficulty (0-100%)" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TURNINGDIFFICULTY" Canvas.Left="184" Canvas.Top="264" Width="32" Height="20" TextAlignment="Center" />
    <TextBlock Canvas.Left="31" Canvas.Top="292" Width="101" Height="13" Text="This rest event has a" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_EVENTCHANCE" Canvas.Left="136" Canvas.Top="287" Width="29" Height="23" />
    <TextBlock Canvas.Left="168" Canvas.Top="292" Width="60" Height="13" Text="% chance of" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="229" Canvas.Top="292" Width="75" Height="13" Text="occurring every" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_EVENTMINUTES" Canvas.Left="306" Canvas.Top="287" Width="28" Height="23" />
    <TextBlock Canvas.Left="339" Canvas.Top="292" Width="40" Height="13" Text="minutes." TextWrapping="Wrap" />
    <CheckBox x:Name="IDC_CANTREST" Canvas.Left="4" Canvas.Top="316" Width="128" Height="17" Content="Cant Rest in this zone" />
    <CheckBox x:Name="IDC_ALLOWMAGIC" Canvas.Left="4" Canvas.Top="333" Width="81" Height="16" Content="Allow Magic" />
    <CheckBox x:Name="IDC_ALLOWAUTODARKEN" Canvas.Left="4" Canvas.Top="349" Width="156" Height="16" Content="Allow Auto Viewport Darken" />
    <TextBox x:Name="IDC_ZONENUMBER" Canvas.Left="163" Canvas.Top="329" Width="35" Height="23" IsReadOnly="True" />
    <NumericUpDown x:Name="IDC_ZONESPIN" Canvas.Left="201" Canvas.Top="329" Width="45" Height="23" /> <!-- msctls_updown32 (UDS_AUTOBUDDY spinner) -->
    <Button x:Name="IDOK" Canvas.Left="129" Canvas.Top="373" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="214" Canvas.Top="373" Width="75" Height="23" Content="Cancel" IsCancel="True" />
    <Button x:Name="IDC_ZONE_DATA" Canvas.Left="10" Canvas.Top="4" Width="35" Height="23" Content="?" />
  </Canvas>
</UserControl>
