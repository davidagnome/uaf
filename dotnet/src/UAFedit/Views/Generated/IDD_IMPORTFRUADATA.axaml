<!--
  IDD_IMPORTFRUADATA — generated by tools/rc2axaml from src/UAFWinEd/UAFWinEd.rc:2601.
  CAPTION "Import FRUA Data"
  305 x 268 dialog units at FONT 8, "MS Sans Serif" (base units 6 x 13) = 457 x 435 px.

  Not hand-edited and not wired into a project: regenerate rather than patch, or move the
  file out of Views/Generated once a real view takes it over.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="457" Height="435">
  <Canvas Width="457" Height="435">
    <Button x:Name="IDOK" Canvas.Left="373" Canvas.Top="341" Width="75" Height="23" Content="Close" IsDefault="True" />
    <TextBlock Canvas.Left="6" Canvas.Top="4" Width="439" Height="18" Text="Importing the Items/Monsters/Spells/Npcs can be done separately if desired." TextWrapping="Wrap" />
    <Button x:Name="IDC_IMPORTFRUAITEMS" Canvas.Left="6" Canvas.Top="279" Width="84" Height="23" Content="Items" />
    <Button x:Name="IDC_IMPORTFRUAMONSTERS" Canvas.Left="6" Canvas.Top="308" Width="84" Height="23" Content="Monsters/Npc" />
    <Button x:Name="IDC_IMPORTFRUADESIGN" Canvas.Left="6" Canvas.Top="338" Width="84" Height="22" Content="Design" />
    <CheckBox x:Name="IDC_ALLINFOLDER" Canvas.Left="94" Canvas.Top="313" Width="75" Height="16" Content="All in folder" />
    <Button x:Name="IDC_UASELECT" Canvas.Left="372" Canvas.Top="182" Width="75" Height="22" Content="Browse" />
    <TextBlock Canvas.Left="4" Canvas.Top="165" Width="243" Height="13" Text="Path to your Unlimited Adventures installation folder" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_UAPATH" Canvas.Left="3" Canvas.Top="182" Width="364" Height="22" />
    <CheckBox x:Name="IDC_INCITEMS" Canvas.Left="94" Canvas.Top="342" Width="87" Height="17" Content="Include Items" />
    <CheckBox x:Name="IDC_INCMONSTERS" Canvas.Left="183" Canvas.Top="342" Width="136" Height="17" Content="Include Monsters/NPCs" />
    <TextBlock Canvas.Left="6" Canvas.Top="22" Width="441" Height="28" Text="If you check the 'Include Items' or 'Include Monsters' checkbox, they will be automatically imported before the design." TextWrapping="Wrap" />
    <CheckBox x:Name="IDC_CLEARMONSTERS" Canvas.Left="10" Canvas.Top="225" Width="279" Height="17" Content="Remove current Monsters/NPCs before starting import" />
    <CheckBox x:Name="IDC_CLEARITEMS" Canvas.Left="10" Canvas.Top="209" Width="230" Height="16" Content="Remove current Items before starting import" />
    <CheckBox x:Name="IDC_INCITEMS2" Canvas.Left="177" Canvas.Top="313" Width="87" Height="16" Content="Include Items" />
    <TextBlock Canvas.Left="6" Canvas.Top="53" Width="391" Height="13" Text="Imported items will always come from the DISK1 folder of your UA installation folder." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="6" Canvas.Top="69" Width="442" Height="13" Text="Imported monsters can come from any folder when importing using the 'Monsters/NPC' button." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="6" Canvas.Top="86" Width="433" Height="13" Text="Imported monsters will come from the design folder when importing using the 'Design' button." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="6" Canvas.Top="104" Width="405" Height="13" Text="The current design data will be cleared before importation of the FRUA design begins." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="370" Width="87" Height="13" Text="Recommendation:" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="21" Canvas.Top="388" Width="304" Height="13" Text="Use 'Monsters/NPC' button to import all 127 files from one folder." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="21" Canvas.Top="406" Width="403" Height="27" Text="Then use 'Design' button to import UA design, and leave 'Include Items' and 'Include Monsters' unchecked." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="6" Canvas.Top="121" Width="438" Height="39" Text="All 127 UA Monster/NPC DAT files can be downloaded in a single zip file from the Magic Mirror website. All FRUA wall and backdrop art in DC format can also be downloaded from the Magic Mirror." TextWrapping="Wrap" />
    <Button x:Name="IDC_IMPORTFRUAART" Canvas.Left="6" Canvas.Top="250" Width="84" Height="23" Content="Art Slots" />
    <CheckBox x:Name="IDC_USECURRENTART" Canvas.Left="94" Canvas.Top="245" Width="261" Height="31" Content="Use currently loaded art for walls and backdrops (else use DC defaults)" />
  </Canvas>
</UserControl>
