<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="526" Height="362">
  <Canvas Width="526" Height="362">
    <Button x:Name="IDOK" Canvas.Left="442" Canvas.Top="173" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="442" Canvas.Top="201" Width="75" Height="23" Content="Cancel" IsCancel="True" />
    <ListBox x:Name="IDC_SPECABMSGLIST" Canvas.Left="6" Canvas.Top="8" Width="424" Height="219" /> <!-- SysListView32 LVS_REPORT (multi-column) -->
    <TextBlock Canvas.Left="7" Canvas.Top="230" Width="329" Height="13" Text="Check each message type that you want to use for this special ability." TextWrapping="Wrap" />
    <Button x:Name="IDC_EDITMSG" Canvas.Left="442" Canvas.Top="126" Width="75" Height="23" Content="Edit Message" />
    <TextBlock Canvas.Left="7" Canvas.Top="251" Width="465" Height="13" Text="During combat each of the above message types will be displayed using default text. For instance, " TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="266" Width="452" Height="13" Text="when a character ends a turn a message is displayed like this: 'Bobo ends turn'.  If you want this" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="281" Width="492" Height="13" Text="special ability to display it's own message when a character ends a turn, check the box next to End Turn" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="295" Width="488" Height="13" Text="and provide your message text by pressing Edit Message.  The custom message will be displayed only if" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="312" Width="468" Height="13" Text="the character actually uses the special ability. For instance, a Vorpal Weapon ability might provide a" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="326" Width="483" Height="13" Text="message like 'Bobo beheads kobold'. The normal attack message would be displayed, and the custom" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="342" Width="420" Height="13" Text="message would be displayed afterwards if the Vorpal Weapon ability is used successfully." TextWrapping="Wrap" />
  </Canvas>
</UserControl>
