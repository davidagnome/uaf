<!--
  IDD_RESCHANGE_DIALOG — generated by tools/rc2axaml from src/UAFWinEd/UAFWinEd.rc:3928.
  CAPTION "Design Resolution Changes"
  285 x 230 dialog units at FONT 8, "MS Sans Serif" (base units 6 x 13) = 427 x 373 px.

  Not hand-edited and not wired into a project: regenerate rather than patch, or move the
  file out of Views/Generated once a real view takes it over.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="427" Height="373">
  <Canvas Width="427" Height="373">
    <TextBlock Canvas.Left="27" Canvas.Top="6" Width="63" Height="13" Text="Install Folder:" TextWrapping="Wrap" />
    <TextBlock x:Name="IDC_INSTALLTEXT" Canvas.Left="94" Canvas.Top="6" Width="323" Height="13" Text="Static" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="15" Canvas.Top="43" Width="75" Height="13" Text="Current Setting:" TextWrapping="Wrap" />
    <TextBlock x:Name="IDC_RESTEXT" Canvas.Left="94" Canvas.Top="43" Width="323" Height="13" Text="Static" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="24" Canvas.Top="71" Width="60" Height="13" Text="New Setting" TextWrapping="Wrap" />
    <RadioButton x:Name="IDC_RES640" Canvas.Left="21" Canvas.Top="87" Width="64" Height="17" Content="640x480" GroupName="IDD_RESCHANGE_DIALOG_Group1" />
    <RadioButton x:Name="IDC_RES800" Canvas.Left="21" Canvas.Top="105" Width="64" Height="16" Content="800x600" GroupName="IDD_RESCHANGE_DIALOG_Group1" />
    <RadioButton x:Name="IDC_RES1024" Canvas.Left="21" Canvas.Top="123" Width="70" Height="16" Content="1024x768" GroupName="IDD_RESCHANGE_DIALOG_Group1" />
    <TextBlock Canvas.Left="118" Canvas.Top="71" Width="141" Height="13" Text="Config.txt file that will be used" TextWrapping="Wrap" />
    <TextBlock x:Name="IDC_640CONFIG" Canvas.Left="118" Canvas.Top="87" Width="293" Height="13" Text="Static" TextWrapping="Wrap" />
    <TextBlock x:Name="IDC_800CONFIG" Canvas.Left="118" Canvas.Top="105" Width="293" Height="13" Text="Static" TextWrapping="Wrap" />
    <TextBlock x:Name="IDC_1024CONFIG" Canvas.Left="118" Canvas.Top="123" Width="293" Height="13" Text="Static" TextWrapping="Wrap" />
    <Button x:Name="ID_UPDATEGAMERES" Canvas.Left="54" Canvas.Top="339" Width="126" Height="23" Content="Change Game Res" />
    <Button x:Name="IDOK" Canvas.Left="229" Canvas.Top="339" Width="117" Height="23" Content="Exit With No Changes" IsDefault="True" />
    <TextBlock Canvas.Left="49" Canvas.Top="323" Width="327" Height="13" Text="You must exit the editor and restart it before any changes will be used" TextWrapping="Wrap" />
    <TextBlock x:Name="IDC_DESIGNPATH" Canvas.Left="94" Canvas.Top="26" Width="323" Height="13" Text="Static" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="21" Canvas.Top="26" Width="69" Height="13" Text="Design Folder:" TextWrapping="Wrap" />
    <CheckBox x:Name="IDC_UPDATEDESIGNCONFIG" Canvas.Left="22" Canvas.Top="147" Width="234" Height="17" Content="Update config.txt file for current design also?" />
    <TextBlock Canvas.Left="7" Canvas.Top="212" Width="411" Height="30" Text=" By default, only the config.txt file that resides in your root install folder is updated. This is the file that will be copied to all future designs when you save the design." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="282" Width="414" Height="30" Text="If you make the game res larger, the editor will automatically adjust it's layout to accommodate the larger graphics when you restart it." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="247" Width="413" Height="30" Text=" You can also update the config.txt that resides in folder of the design that is currently being edited by checking the box." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="7" Canvas.Top="180" Width="399" Height="31" Text="Changing the game res involves swapping your current config.txt file for one that has the correct layout for the new res." TextWrapping="Wrap" />
  </Canvas>
</UserControl>
