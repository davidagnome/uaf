<!--
  IDD_TOUREVENT — generated by tools/rc2axaml from src/UAFWinEd/UAFWinEd.rc:800.
  CAPTION "Guided Tour Event Data"
  202 x 178 dialog units at FONT 8, "MS Sans Serif" (base units 6 x 13) = 303 x 289 px.

  Not hand-edited and not wired into a project: regenerate rather than patch, or move the
  file out of Views/Generated once a real view takes it over.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="303" Height="289">
  <Canvas Width="303" Height="289">
    <HeaderedContentControl Canvas.Left="10" Canvas.Top="4" Width="192" Height="109" Header="Starting Location" />
    <CheckBox x:Name="IDC_STARTLOC" Canvas.Left="42" Canvas.Top="24" Width="127" Height="16" Content="Use Starting Location" />
    <TextBlock Canvas.Left="24" Canvas.Top="47" Width="19" Height="13" Text="Col" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_COL" Canvas.Left="19" Canvas.Top="61" Width="30" Height="23" />
    <TextBlock Canvas.Left="57" Canvas.Top="47" Width="24" Height="13" Text="Row" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_ROW" Canvas.Left="55" Canvas.Top="61" Width="29" Height="23" />
    <TextBlock Canvas.Left="112" Canvas.Top="47" Width="33" Height="13" Text="Facing" TextAlignment="Center" TextWrapping="Wrap" />
    <ComboBox x:Name="IDC_FACING" Canvas.Left="91" Canvas.Top="63" Width="104" Height="23" />
    <TextBlock Canvas.Left="193" Canvas.Top="141" Width="56" Height="13" Text="Tour Step" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TOURSTEP" Canvas.Left="186" Canvas.Top="159" Width="30" Height="23" IsReadOnly="True" />
    <NumericUpDown x:Name="IDC_SPINSTEP" Canvas.Left="222" Canvas.Top="159" Width="36" Height="23" /> <!-- msctls_updown32 (UDS_AUTOBUDDY spinner) -->
    <TextBlock Canvas.Left="63" Canvas.Top="144" Width="63" Height="13" Text="Step taken" TextAlignment="Center" TextWrapping="Wrap" />
    <ComboBox x:Name="IDC_STEPTAKEN" Canvas.Left="45" Canvas.Top="160" Width="111" Height="23" />
    <CheckBox x:Name="IDC_EXECUTEEVENT" Canvas.Left="13" Canvas.Top="121" Width="180" Height="17" Content="Execute event at ending location" />
    <TextBox x:Name="IDC_STEPTEXT" Canvas.Left="6" Canvas.Top="204" Width="289" Height="59" AcceptsReturn="True" TextWrapping="Wrap" />
    <Button x:Name="IDOK" Canvas.Left="219" Canvas.Top="11" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="219" Canvas.Top="39" Width="75" Height="22" Content="Cancel" IsCancel="True" />
    <TextBlock Canvas.Left="9" Canvas.Top="188" Width="78" Height="13" Text="Player Reads..." TextWrapping="Wrap" />
    <TextBlock x:Name="IDC_LEVELSIZE" Canvas.Left="21" Canvas.Top="92" Width="108" Height="13" Text="Current level is 10 x 10" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="30" Canvas.Top="268" Width="234" Height="13" Text="This text gets displayed after the step takes place" TextWrapping="Wrap" />
    <Button x:Name="IDC_GUIDED_TOUR" Canvas.Left="240" Canvas.Top="76" Width="31" Height="23" Content="?" />
  </Canvas>
</UserControl>
