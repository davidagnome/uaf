<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="408" Height="334">
  <Canvas Width="408" Height="334">
    <Button x:Name="IDC_TRAINER" Canvas.Left="73" Canvas.Top="178" Width="113" Height="23" Content="No Pic" />
    <CheckBox x:Name="IDC_FORCEEXIT" Canvas.Left="199" Canvas.Top="183" Width="71" Height="16" Content="Force Exit" />
    <Button x:Name="IDOK" Canvas.Left="37" Canvas.Top="308" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="120" Canvas.Top="308" Width="75" Height="23" Content="Cancel" IsCancel="True" />
    <TextBlock Canvas.Left="10" Canvas.Top="183" Width="56" Height="13" Text="Player sees" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="10" Canvas.Top="222" Width="60" Height="13" Text="Player reads" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TEXT" Canvas.Left="7" Canvas.Top="240" Width="314" Height="62" AcceptsReturn="True" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="124" Canvas.Top="214" Width="62" Height="13" Text="Cost to Train" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TRAINCOST" Canvas.Left="187" Canvas.Top="209" Width="60" Height="23" />
    <TextBlock x:Name="IDC_COINNAME" Canvas.Left="253" Canvas.Top="214" Width="77" Height="13" Text="Platinum" TextWrapping="Wrap" />
    <ListBox x:Name="IDC_CLASSLIST" Canvas.Left="15" Canvas.Top="8" Width="285" Height="162" /> <!-- SysListView32 LVS_REPORT (multi-column) -->
    <Button x:Name="IDC_ADD" Canvas.Left="307" Canvas.Top="8" Width="90" Height="22" Content="Add Baseclass" />
    <Button x:Name="IDC_EDIT" Canvas.Left="307" Canvas.Top="40" Width="90" Height="23" Content="Edit Baseclass" />
    <Button x:Name="IDC_DELETE" Canvas.Left="307" Canvas.Top="73" Width="90" Height="22" Content="Delete Baseclass" />
  </Canvas>
</UserControl>
