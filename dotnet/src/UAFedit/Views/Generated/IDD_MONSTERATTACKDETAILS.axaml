<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="283" Height="297">
  <Canvas Width="283" Height="297">
    <TextBlock Canvas.Left="25" Canvas.Top="14" Width="57" Height="13" Text="Attack Dice" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="16" Canvas.Top="68" Width="66" Height="13" Text="Attack Bonus" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="4" Canvas.Top="40" Width="78" Height="13" Text="Nbr Attack Dice" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_ATTACKDICE" Canvas.Left="87" Canvas.Top="9" Width="60" Height="23" />
    <TextBox x:Name="IDC_ATTACKNBRDICE" Canvas.Left="87" Canvas.Top="35" Width="60" Height="23" />
    <TextBox x:Name="IDC_ATTACKBONUS" Canvas.Left="87" Canvas.Top="63" Width="60" Height="23" />
    <TextBlock Canvas.Left="4" Canvas.Top="94" Width="78" Height="13" Text="Attack Message" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="153" Canvas.Top="14" Width="96" Height="13" Text="(sides on each dice)" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="153" Canvas.Top="40" Width="106" Height="13" Text="(how many dice to roll)" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="153" Canvas.Top="66" Width="70" Height="13" Text="(bonus per roll)" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_MONSTERATTACKMSG" Canvas.Left="87" Canvas.Top="89" Width="156" Height="23" />
    <TextBlock Canvas.Left="6" Canvas.Top="115" Width="276" Height="13" Text="The attack message can be up to 20 characters in length." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="6" Canvas.Top="133" Width="231" Height="27" Text="It will automatically be inserted into the combat attack message displayed to the player." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="6" Canvas.Top="165" Width="234" Height="52" Text="For instance, an attack message of 'breathes on' will automatically be formatted using the monster and target names as in - 'Dragon breathes on Kobold'" TextWrapping="Wrap" />
    <Button x:Name="IDC_INVOKESPELL" Canvas.Left="142" Canvas.Top="227" Width="105" Height="23" Content="Spell Name" />
    <TextBlock Canvas.Left="7" Canvas.Top="227" Width="128" Height="24" Text="Cast this spell on target if attack succeeds" TextAlignment="Center" TextWrapping="Wrap" />
    <Button x:Name="IDOK" Canvas.Left="57" Canvas.Top="268" Width="75" Height="22" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="151" Canvas.Top="268" Width="75" Height="22" Content="Cancel" IsCancel="True" />
  </Canvas>
</UserControl>
