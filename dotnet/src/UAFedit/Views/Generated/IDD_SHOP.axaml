<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="409" Height="242">
  <Canvas Width="409" Height="242">
    <TextBlock Canvas.Left="6" Canvas.Top="6" Width="60" Height="13" Text="Shopkeeper" TextWrapping="Wrap" />
    <Button x:Name="IDC_RETAILER" Canvas.Left="69" Canvas.Top="1" Width="112" Height="23" Content="Shopkeeper" />
    <Button x:Name="IDC_CHOOSE_ITEMS" Canvas.Left="69" Canvas.Top="27" Width="112" Height="23" Content="Items Available" />
    <CheckBox x:Name="IDC_CANID" Canvas.Left="189" Canvas.Top="4" Width="108" Height="17" Content="Can Identify Items" />
    <CheckBox x:Name="IDC_CANAPPRGEMS" Canvas.Left="189" Canvas.Top="22" Width="216" Height="17" Content="Can Appraise Gems" />
    <CheckBox x:Name="IDC_CANAPPRJEWELS" Canvas.Left="189" Canvas.Top="40" Width="216" Height="16" Content="Can Appraise Jewelry" />
    <TextBlock Canvas.Left="10" Canvas.Top="55" Width="149" Height="13" Text="Upon entry, shopkeeper says..." TextWrapping="Wrap" />
    <TextBox x:Name="IDC_SHOPENTERTEXT" Canvas.Left="10" Canvas.Top="69" Width="389" Height="52" AcceptsReturn="True" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="6" Canvas.Top="131" Width="55" Height="13" Text="Cost Factor" TextWrapping="Wrap" />
    <ComboBox x:Name="IDC_COSTFACTOR" Canvas.Left="67" Canvas.Top="128" Width="138" Height="23" />
    <CheckBox x:Name="IDC_FORCEEXIT" Canvas.Left="238" Canvas.Top="131" Width="71" Height="16" Content="Force Exit" />
    <TextBlock Canvas.Left="6" Canvas.Top="159" Width="108" Height="13" Text="Cost to identify an item" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_IDCOST" Canvas.Left="120" Canvas.Top="156" Width="60" Height="19" />
    <TextBlock x:Name="IDC_MONEYNAME" Canvas.Left="183" Canvas.Top="159" Width="163" Height="13" Text="Platinum" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="6" Canvas.Top="185" Width="114" Height="13" Text="Buy back percentage is" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_BUYBACK" Canvas.Left="120" Canvas.Top="182" Width="27" Height="19" />
    <TextBlock Canvas.Left="148" Canvas.Top="185" Width="117" Height="13" Text="% of original cost (0-100)" TextWrapping="Wrap" />
    <CheckBox x:Name="IDC_BUYITEMSSOLDONLY" Canvas.Left="274" Canvas.Top="175" Width="116" Height="33" Content="Buy back only items that are sold" />
    <Button x:Name="IDOK" Canvas.Left="97" Canvas.Top="212" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="178" Canvas.Top="212" Width="75" Height="23" Content="Cancel" IsCancel="True" />
  </Canvas>
</UserControl>
