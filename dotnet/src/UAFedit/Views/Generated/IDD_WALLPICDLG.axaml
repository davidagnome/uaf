    <TextBlock Canvas.Left="21" Canvas.Top="157" Width="36" Height="13" Text="Format:" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_IMAGEFORMAT" Canvas.Left="63" Canvas.Top="154" Width="34" Height="21" IsReadOnly="True" />
    <Button x:Name="IDC_CLEAR" Canvas.Left="127" Canvas.Top="34" Width="75" Height="22" Content="Clear Slot" />
