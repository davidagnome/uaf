<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="211" Height="253">
  <Canvas Width="211" Height="253">
    <Border x:Name="IDC_WallPicture" Canvas.Left="6" Canvas.Top="11" Width="114" Height="136" BorderBrush="Gray" BorderThickness="1" />
    <Button x:Name="IDC_SELECTFILE" Canvas.Left="127" Canvas.Top="6" Width="75" Height="23" Content="Load Art" />
