<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="309" Height="154">
  <Canvas Width="309" Height="154">
    <TextBlock Canvas.Left="4" Canvas.Top="16" Width="75" Height="13" Text="Selected Movie" TextWrapping="Wrap" />
    <Button x:Name="IDC_CHOOSEMOVIE" Canvas.Left="85" Canvas.Top="11" Width="113" Height="23" Content="None" />
    <Button x:Name="IDC_TESTMOVIE" Canvas.Left="85" Canvas.Top="40" Width="113" Height="23" Content="Play Movie" />
    <RadioButton x:Name="IDC_PLAYBACKSIZE" Canvas.Left="10" Canvas.Top="69" Width="72" Height="17" Content="Fullscreen" GroupName="IDD_PLAYMOVIEFULLSCREEN_Group3" />
    <RadioButton x:Name="IDC_PLAYBACKSIZE2" Canvas.Left="10" Canvas.Top="86" Width="111" Height="16" Content="In Big Pic Window" GroupName="IDD_PLAYMOVIEFULLSCREEN_Group3" />
    <RadioButton x:Name="IDC_PLAYBACKSIZE3" Canvas.Left="10" Canvas.Top="102" Width="122" Height="16" Content="In Small Pic Window" GroupName="IDD_PLAYMOVIEFULLSCREEN_Group3" />
    <TextBlock Canvas.Left="10" Canvas.Top="125" Width="288" Height="31" Text="To play the movie in the editor, you must have an AVI player already installed. The engine will handle playback by itself." TextWrapping="Wrap" />
    <Button x:Name="IDOK" Canvas.Left="222" Canvas.Top="11" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="222" Canvas.Top="40" Width="75" Height="23" Content="Cancel" IsCancel="True" />
  </Canvas>
</UserControl>
