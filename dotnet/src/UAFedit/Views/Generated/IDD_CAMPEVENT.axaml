<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="321" Height="175">
  <Canvas Width="321" Height="175">
    <TextBox x:Name="IDC_TEXT" Canvas.Left="10" Canvas.Top="79" Width="300" Height="90" AcceptsReturn="True" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="16" Canvas.Top="14" Width="59" Height="15" Text="Player Sees" TextWrapping="Wrap" />
    <Button x:Name="IDC_CAMPART" Canvas.Left="79" Canvas.Top="9" Width="113" Height="23" Content="Small Picture" />
    <CheckBox x:Name="IDC_BACKUP" Canvas.Left="16" Canvas.Top="39" Width="144" Height="17" Content="Backup One Step On Exit" />
    <TextBlock Canvas.Left="13" Canvas.Top="63" Width="63" Height="13" Text="Player reads:" TextWrapping="Wrap" />
    <Button x:Name="IDOK" Canvas.Left="232" Canvas.Top="11" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="232" Canvas.Top="39" Width="75" Height="22" Content="Cancel" IsCancel="True" />
  </Canvas>
</UserControl>
