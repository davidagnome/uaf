<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="315" Height="162">
  <Canvas Width="315" Height="162">
    <TextBlock Canvas.Left="6" Canvas.Top="3" Width="30" Height="13" Text="Name" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_NAME" Canvas.Left="4" Canvas.Top="19" Width="306" Height="23" />
    <RadioButton x:Name="IDC_SPECIALITEM" Canvas.Left="10" Canvas.Top="50" Width="83" Height="16" Content="Special Item" GroupName="IDD_ADDSPECIALOBJECT_Group1" />
    <RadioButton x:Name="IDC_SPECIALKEY" Canvas.Left="10" Canvas.Top="66" Width="80" Height="16" Content="Special Key" GroupName="IDD_ADDSPECIALOBJECT_Group1" />
    <RadioButton x:Name="IDC_QUEST" Canvas.Left="10" Canvas.Top="82" Width="53" Height="17" Content="Quest" GroupName="IDD_ADDSPECIALOBJECT_Group1" />
    <Button x:Name="IDOK" Canvas.Left="76" Canvas.Top="131" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="160" Canvas.Top="131" Width="75" Height="23" Content="Cancel" IsCancel="True" />
    <TextBlock Canvas.Left="127" Canvas.Top="52" Width="72" Height="13" Text="Examine Event" TextWrapping="Wrap" />
    <Button x:Name="IDC_EXAMINEEVENT" Canvas.Left="202" Canvas.Top="47" Width="105" Height="22" Content="None" />
    <TextBlock Canvas.Left="129" Canvas.Top="79" Width="70" Height="13" Text="Examine Label" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_EXAMINELABEL" Canvas.Left="202" Canvas.Top="74" Width="104" Height="23" />
    <CheckBox x:Name="IDC_CANBEDROPPED" Canvas.Left="12" Canvas.Top="104" Width="139" Height="16" Content="Can be dropped by party" />
  </Canvas>
</UserControl>
