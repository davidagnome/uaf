    <Button x:Name="IDC_ART" Canvas.Left="73" Canvas.Top="14" Width="113" Height="23" Content="No Pic" />
    <TextBlock Canvas.Left="12" Canvas.Top="56" Width="60" Height="13" Text="Player reads" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TEXT" Canvas.Left="10" Canvas.Top="73" Width="267" Height="68" AcceptsReturn="True" TextWrapping="Wrap" />
    <Button x:Name="IDC_QUESTSELECT" Canvas.Left="123" Canvas.Top="146" Width="112" Height="23" Content="No Quest" />
