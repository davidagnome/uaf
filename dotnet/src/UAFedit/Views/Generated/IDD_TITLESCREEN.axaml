<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="279" Height="154">
  <Canvas Width="279" Height="154">
    <TextBlock Canvas.Left="7" Canvas.Top="16" Width="44" Height="13" Text="Filename" TextWrapping="Wrap" />
    <Button x:Name="IDC_SELECTTITLEFILENAME" Canvas.Left="55" Canvas.Top="9" Width="113" Height="23" Content="None" />
    <CheckBox x:Name="IDC_USETRANS" Canvas.Left="7" Canvas.Top="40" Width="111" Height="16" Content="Use Transparency" />
    <CheckBox x:Name="IDC_BLENDWITHPREV" Canvas.Left="7" Canvas.Top="56" Width="170" Height="17" Content="Blend with previous title screen" />
    <HeaderedContentControl Canvas.Left="4" Canvas.Top="78" Width="149" Height="73" Header="Display Styles" />
    <RadioButton x:Name="IDC_DISPLAYSTYLE" Canvas.Left="12" Canvas.Top="97" Width="138" Height="16" Content="No effects, just display it" GroupName="IDD_TITLESCREEN_Group2" />
    <RadioButton x:Name="IDC_DISPLAYSTYLE2" Canvas.Left="12" Canvas.Top="113" Width="67" Height="17" Content="Fade it in" GroupName="IDD_TITLESCREEN_Group2" />
    <RadioButton x:Name="IDC_DISPLAYSTYLE3" Canvas.Left="12" Canvas.Top="130" Width="94" Height="16" Content="This is a movie" GroupName="IDD_TITLESCREEN_Group2" />
    <Button x:Name="IDOK" Canvas.Left="193" Canvas.Top="11" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="193" Canvas.Top="39" Width="75" Height="22" Content="Cancel" IsCancel="True" />
  </Canvas>
</UserControl>
