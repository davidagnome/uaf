    <CheckBox x:Name="IDC_SEARCHEVENTID" Canvas.Left="129" Canvas.Top="74" Width="109" Height="17" Content="Search Event ID's" />
    <Button x:Name="IDC_FIND" Canvas.Left="223" Canvas.Top="4" Width="75" Height="23" Content="Find" />
    <Button x:Name="IDOK" Canvas.Left="225" Canvas.Top="34" Width="75" Height="22" Content="Close" IsDefault="True" />
  </Canvas>
</UserControl>
