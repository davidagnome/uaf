<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="309" Height="94">
  <Canvas Width="309" Height="94">
    <TextBox x:Name="IDC_SEARCHTEXT" Canvas.Left="6" Canvas.Top="8" Width="205" Height="22" />
    <CheckBox x:Name="IDC_MATCHCASE" Canvas.Left="7" Canvas.Top="35" Width="80" Height="17" Content="Match case" />
