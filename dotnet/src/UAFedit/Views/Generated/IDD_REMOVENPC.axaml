<!--
  IDD_REMOVENPC — generated by tools/rc2axaml from src/UAFWinEd/UAFWinEd.rc:850.
  CAPTION "Remove NPC"
  273 x 125 dialog units at FONT 8, "MS Sans Serif" (base units 6 x 13) = 409 x 203 px.

  Not hand-edited and not wired into a project: regenerate rather than patch, or move the
  file out of Views/Generated once a real view takes it over.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="409" Height="203">
  <Canvas Width="409" Height="203">
    <TextBlock Canvas.Left="7" Canvas.Top="16" Width="57" Height="14" Text="Player Sees" TextWrapping="Wrap" />
    <Button x:Name="IDC_SEECHAR" Canvas.Left="67" Canvas.Top="11" Width="113" Height="23" Content="Small Picture" />
    <ComboBox x:Name="IDC_DISTANCE" Canvas.Left="192" Canvas.Top="11" Width="97" Height="23" /> <!-- CBS_DROPDOWN: the original accepted typed text; Avalonia's ComboBox does not -->
    <TextBlock Canvas.Left="10" Canvas.Top="55" Width="71" Height="16" Text="Player Reads" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TEXT" Canvas.Left="10" Canvas.Top="73" Width="390" Height="89" AcceptsReturn="True" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="19" Canvas.Top="177" Width="71" Height="14" Text="Remove NPC" TextWrapping="Wrap" />
    <Button x:Name="IDC_REMOVECHAR" Canvas.Left="93" Canvas.Top="172" Width="112" Height="23" Content="Nobody" />
    <Button x:Name="IDOK" Canvas.Left="322" Canvas.Top="9" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="322" Canvas.Top="37" Width="75" Height="23" Content="Cancel" IsCancel="True" />
  </Canvas>
</UserControl>
