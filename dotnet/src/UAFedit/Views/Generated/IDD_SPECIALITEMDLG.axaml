<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="459" Height="289">
  <Canvas Width="459" Height="289">
    <TextBlock Canvas.Left="9" Canvas.Top="11" Width="57" Height="13" Text="Player sees" TextWrapping="Wrap" />
    <Button x:Name="IDC_CHOOSEART" Canvas.Left="70" Canvas.Top="6" Width="113" Height="23" Content="Small Picture" />
    <CheckBox x:Name="IDC_FORCEBACKUP" Canvas.Left="175" Canvas.Top="40" Width="182" Height="16" Content="Force party to backup after event" />
    <TextBlock Canvas.Left="4" Canvas.Top="52" Width="62" Height="13" Text="Player reads" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TEXT" Canvas.Left="1" Canvas.Top="68" Width="450" Height="57" AcceptsReturn="True" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="79" Canvas.Top="136" Width="63" Height="13" Text="Give to Party" TextWrapping="Wrap" />
    <ListBox x:Name="IDC_GIVELIST" Canvas.Left="7" Canvas.Top="156" Width="218" Height="94" /> <!-- SysListView32 LVS_REPORT (multi-column) -->
    <Button x:Name="IDC_GIVEKEY" Canvas.Left="31" Canvas.Top="256" Width="75" Height="23" Content="Add" />
    <Button x:Name="IDC_REMOVEGIVE" Canvas.Left="117" Canvas.Top="256" Width="75" Height="23" Content="Remove" />
    <TextBlock Canvas.Left="304" Canvas.Top="136" Width="77" Height="13" Text="Take from Party" TextWrapping="Wrap" />
    <ListBox x:Name="IDC_TAKELIST" Canvas.Left="234" Canvas.Top="156" Width="217" Height="94" /> <!-- SysListView32 LVS_REPORT (multi-column) -->
    <Button x:Name="IDC_TAKEKEY" Canvas.Left="256" Canvas.Top="256" Width="75" Height="23" Content="Add" />
    <Button x:Name="IDC_REMOVETAKE" Canvas.Left="342" Canvas.Top="256" Width="75" Height="23" Content="Remove" />
    <Button x:Name="IDOK" Canvas.Left="375" Canvas.Top="6" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="375" Canvas.Top="35" Width="75" Height="23" Content="Cancel" IsCancel="True" />
  </Canvas>
</UserControl>
