<!--
  IDD_TAVERNTALES — generated by tools/rc2axaml from src/UAFWinEd/UAFWinEd.rc:4416.
  CAPTION "Tavern Tales"
  249 x 230 dialog units at FONT 8, "MS Sans Serif" (base units 6 x 13) = 373 x 373 px.

  Not hand-edited and not wired into a project: regenerate rather than patch, or move the
  file out of Views/Generated once a real view takes it over.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="373" Height="373">
  <Canvas Width="373" Height="373">
    <Button x:Name="IDOK" Canvas.Left="201" Canvas.Top="339" Width="75" Height="23" Content="OK" IsDefault="True" />
    <Button x:Name="IDCANCEL" Canvas.Left="298" Canvas.Top="339" Width="75" Height="23" Content="Cancel" IsCancel="True" />
    <TextBlock Canvas.Left="24" Canvas.Top="165" Width="46" Height="13" Text="Tale Text" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TALETEXT" Canvas.Left="27" Canvas.Top="185" Width="321" Height="83" AcceptsReturn="True" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="108" Canvas.Top="282" Width="66" Height="13" Text="Tale Number" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TALE_NUM" Canvas.Left="177" Canvas.Top="277" Width="51" Height="25" IsReadOnly="True" />
    <NumericUpDown x:Name="IDC_TALESPIN" Canvas.Left="169" Canvas.Top="303" Width="60" Height="22" /> <!-- msctls_updown32 (UDS_AUTOBUDDY spinner) -->
    <CheckBox x:Name="IDC_CUMULATIVE" Canvas.Left="10" Canvas.Top="11" Width="335" Height="16" Content="Cumulative - Add thesse tales to any preceeding TAVERN TALES" />
    <TextBlock Canvas.Left="25" Canvas.Top="312" Width="140" Height="13" Text="You can use Page Up/Down" TextWrapping="Wrap" />
    <CheckBox x:Name="IDC_DRINK" Canvas.Left="10" Canvas.Top="29" Width="245" Height="16" Content="Tell these tales only if the party has had a drink" />
    <CheckBox x:Name="IDC_DRUNK" Canvas.Left="10" Canvas.Top="47" Width="209" Height="16" Content="Tell these tales only if the party is drunk" />
    <CheckBox x:Name="IDC_REPLACE" Canvas.Left="10" Canvas.Top="65" Width="276" Height="16" Content="Replace the TAVERN tales instead of adding to them" />
    <HeaderedContentControl Canvas.Left="10" Canvas.Top="94" Width="357" Height="235" Header="A Single Tale" />
    <CheckBox x:Name="IDC_Highlight" Canvas.Left="25" Canvas.Top="118" Width="113" Height="16" Content="Highlight This Tale" />
  </Canvas>
</UserControl>
