  CAPTION "Combat Icon"
  296 x 298 dialog units at FONT 8, "MS Sans Serif" (base units 6 x 13) = 444 x 484 px.

  Not hand-edited and not wired into a project: regenerate rather than patch, or move the
  file out of Views/Generated once a real view takes it over.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="444" Height="484">
  <Canvas Width="444" Height="484">
    <Button x:Name="IDOK" Canvas.Left="355" Canvas.Top="193" Width="75" Height="23" Content="OK" />
    <Button x:Name="IDCANCEL" Canvas.Left="355" Canvas.Top="224" Width="75" Height="23" Content="Cancel" IsDefault="True" IsCancel="True" />
    <Border x:Name="IDC_ICONPICTURE" Canvas.Left="1" Canvas.Top="4" Width="332" Height="251" BorderBrush="Gray" BorderThickness="1" />
    <Button x:Name="IDC_SELECTFILE" Canvas.Left="49" Canvas.Top="260" Width="113" Height="22" Content="Load" />
    <TextBlock Canvas.Left="3" Canvas.Top="299" Width="420" Height="30" Text="Icons must be a multiple of 48 in height/width. Each icon must contain at least two pose images, a Ready pose and an Attack pose. Each pose is considered a single frame." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="3" Canvas.Top="282" Width="33" Height="13" Text="Notes:" TextWrapping="Wrap" />
    <Button x:Name="IDC_VIEWALLPIC" Canvas.Left="354" Canvas.Top="112" Width="81" Height="22" Content="View Entire Pic" />
    <TextBlock Canvas.Left="18" Canvas.Top="264" Width="25" Height="13" Text="Load" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="340" Canvas.Top="34" Width="36" Height="13" Text="Frames" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_FRAMES" Canvas.Left="379" Canvas.Top="30" Width="60" Height="23" />
    <TextBlock Canvas.Left="1" Canvas.Top="329" Width="278" Height="13" Text="All frames must be ordered from left to right on a single row." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="126" Canvas.Top="404" Width="82" Height="13" Text="1x1 icon = 96x48" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="238" Canvas.Top="404" Width="89" Height="13" Text="2x2 icon = 192x96" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="1" Canvas.Top="368" Width="119" Height="13" Text="Each icon pose must be:" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="126" Canvas.Top="368" Width="88" Height="13" Text="48x48 for 1x1 icon" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="238" Canvas.Top="385" Width="89" Height="13" Text="96x96 for 2x2 icon" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="126" Canvas.Top="385" Width="88" Height="13" Text="96x48 for 2x1 icon" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="238" Canvas.Top="368" Width="89" Height="13" Text="48x96 for 1x2 icon" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="3" Canvas.Top="404" Width="108" Height="13" Text="File sizes with 2 frames" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="3" Canvas.Top="419" Width="108" Height="13" Text="File sizes with 4 frames" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="3" Canvas.Top="435" Width="108" Height="13" Text="File sizes with 6 frames" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="126" Canvas.Top="419" Width="88" Height="13" Text="1x1 icon = 192x48" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="126" Canvas.Top="435" Width="88" Height="13" Text="1x1 icon = 288x48" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="238" Canvas.Top="419" Width="89" Height="13" Text="2x2 icon = 384x96" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="238" Canvas.Top="435" Width="89" Height="13" Text="2x2 icon = 576x96" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="1" Canvas.Top="349" Width="158" Height="13" Text="All poses should face to the right." TextWrapping="Wrap" />
    <Button x:Name="IDC_CLEARICON" Canvas.Left="211" Canvas.Top="260" Width="113" Height="22" Content="Clear" />
    <TextBlock Canvas.Left="349" Canvas.Top="56" Width="87" Height="25" Text="A multiple of 2&#10;Min is 2" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="4" Canvas.Top="455" Width="434" Height="29" Text="If using 4 or more frames, then you will need to use the Logic Block event (using SetIconIndexByName) to select each pair during game play." TextWrapping="Wrap" />
  </Canvas>
</UserControl>
