             Width="316" Height="323">
  <Canvas Width="316" Height="323">
    <TextBlock Canvas.Left="4" Canvas.Top="13" Width="56" Height="13" Text="Player sees" TextWrapping="Wrap" />
    <Button x:Name="IDC_CHOOSESPIC" Canvas.Left="63" Canvas.Top="8" Width="112" Height="22" Content="Small Pic" />
    <Button x:Name="IDC_TELEPORT" Canvas.Left="189" Canvas.Top="8" Width="112" Height="22" Content="Teleport Destination" />
    <TextBlock Canvas.Left="6" Canvas.Top="39" Width="147" Height="13" Text="Question to ask before transfer" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_QUESTIONTEXT" Canvas.Left="4" Canvas.Top="55" Width="306" Height="52" AcceptsReturn="True" TextWrapping="Wrap" />
    <CheckBox x:Name="IDC_ASKYESNOQ" Canvas.Left="7" Canvas.Top="113" Width="134" Height="17" Content="Ask Yes/No Question?" />
    <CheckBox x:Name="IDC_DESTROYDROW" Canvas.Left="7" Canvas.Top="130" Width="209" Height="16" Content="Destroy Drow equipment after transfer?" />
    <TextBlock Canvas.Left="7" Canvas.Top="151" Width="56" Height="13" Text="Transfer on" TextWrapping="Wrap" />
    <RadioButton x:Name="IDC_YESTRANSFER" Canvas.Left="72" Canvas.Top="151" Width="42" Height="16" Content="Yes" GroupName="IDD_TRANSFERDLG_Group1" />
    <RadioButton x:Name="IDC_NOTRANSFER" Canvas.Left="115" Canvas.Top="151" Width="38" Height="16" Content="No" GroupName="IDD_TRANSFERDLG_Group1" />
    <TextBlock Canvas.Left="9" Canvas.Top="170" Width="99" Height="13" Text="Activate event when" TextWrapping="Wrap" />
    <RadioButton x:Name="IDC_ATTEMPTSENTRY" Canvas.Left="114" Canvas.Top="170" Width="117" Height="16" Content="Party attempts entry" GroupName="IDD_TRANSFERDLG_Group2" />
    <RadioButton x:Name="IDC_AFTERENTRY" Canvas.Left="114" Canvas.Top="186" Width="106" Height="17" Content="Party has entered" GroupName="IDD_TRANSFERDLG_Group2" />
    <TextBlock Canvas.Left="6" Canvas.Top="212" Width="132" Height="13" Text="Text displayed after transfer" TextWrapping="Wrap" />
    <TextBox x:Name="IDC_TRANSFERTEXT" Canvas.Left="6" Canvas.Top="229" Width="306" Height="52" AcceptsReturn="True" TextWrapping="Wrap" />
    <Button x:Name="IDOK" Canvas.Left="73" Canvas.Top="294" Width="75" Height="22" Content="OK" />
    <Button x:Name="IDCANCEL" Canvas.Left="168" Canvas.Top="294" Width="75" Height="22" Content="Cancel" IsDefault="True" IsCancel="True" />
  </Canvas>
</UserControl>
