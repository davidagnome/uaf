    <TextBlock Canvas.Left="126" Canvas.Top="156" Width="97" Height="50" Text="Keep in mind that the 'Use' event can be triggered during combat!" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBlock Canvas.Left="255" Canvas.Top="4" Width="142" Height="31" Text="Spells occur when character chooses to &quot;Use&quot; the item" TextAlignment="Center" TextWrapping="Wrap" />
    <CheckBox x:Name="IDC_USABLE" Canvas.Left="285" Canvas.Top="37" Width="57" Height="16" Content="Usable" />
