    <TextBlock Canvas.Left="133" Canvas.Top="320" Width="236" Height="57" Text="2) The item is cursed&#10;3) The item has nonzero protection bonus &#10;4) The item has a nonzero attack bonus &#10;5) The item has a valid spell   " TextWrapping="Wrap" />
