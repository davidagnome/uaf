    <TextBlock Canvas.Left="21" Canvas.Top="186" Width="366" Height="49" Text="When the 'Entry Point' is defined as 'Script' then the teleporter destination is determined at runtime by a script from the Special Ability named &quot;TeleporterDestinations&quot; ." TextWrapping="Wrap" />
    <TextBlock Canvas.Left="21" Canvas.Top="235" Width="367" Height="57" Text="The name of the script is '/Level/X/Y'  where Level, X, and Y are the decimal values specified above.  For example:&#10;&quot;/1/3/12&quot;.  The script should return the destination in the form '/level/x/y'.  For example: &quot;/2/6/4&quot;." TextWrapping="Wrap" />
    <ComboBox x:Name="IDC_LevelSelect" Canvas.Left="106" Canvas.Top="22" Width="276" Height="23" /> <!-- CBS_DROPDOWN: the original accepted typed text; Avalonia's ComboBox does not -->
