<!--
  The editor's shell: a menu, and a tab per pane.

  Everything the panes show comes from MainWindowViewModel; the view holds no design state.

  The first tab is the read-only inspector — a navigation tree and a record list. Its right pane is
  a header row plus a virtualising ListBox rather than a DataGrid, which would mean another package
  for a read-only table whose columns are already known per category.

  The other six are the editors, and each binds its DataContext to a pane the view model builds on
  first selection rather than on open. The views are constructed with that binding still null and
  show nothing until it arrives, which is what makes the laziness invisible here — see
  MainWindowViewModel.Show for why two of them must not be built eagerly.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UAFedit.ViewModels"
        xmlns:cr="using:UAFedit.CrossReference"
        xmlns:db="using:UAFedit.Databases"
        xmlns:ev="using:UAFedit.Events"
        xmlns:globals="using:UAFedit.Globals"
        xmlns:levels="using:UAFedit.Levels"
        xmlns:spells="using:UAFedit.Spells"
        x:Class="UAFedit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}" Width="1100" Height="750">

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New Design…" Command="{Binding NewDesignCommand}" />
        <MenuItem Header="_Open Design…" Command="{Binding OpenDesignCommand}" />
        <MenuItem Header="_Save" Command="{Binding SaveDesignCommand}"
                  IsEnabled="{Binding IsDirty}" InputGesture="Ctrl+S" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#20808080"
            Padding="10,5">
      <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </Border>

    <TabControl SelectedIndex="{Binding SelectedPane, Mode=TwoWay}">

      <TabItem Header="Design">
        <Grid ColumnDefinitions="280,4,*">

      <TreeView Grid.Column="0"
                ItemsSource="{Binding Roots}"
                SelectedItem="{Binding SelectedNode}">
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="vm:DesignNodeViewModel" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}" />
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
        <TreeView.Styles>
          <!-- The design's own node opens itself, so the categories are visible on load. -->
          <Style Selector="TreeViewItem" x:DataType="vm:DesignNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
      </TreeView>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <DockPanel Grid.Column="2" Margin="8,4,4,4">

        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#40808080"
                Padding="0,0,0,4" Margin="0,0,0,4">
          <ItemsControl ItemsSource="{Binding Columns}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:RecordColumn">
                <TextBlock Text="{Binding Header}" Width="{Binding Width}"
                           FontWeight="SemiBold" Margin="4,0"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <ListBox ItemsSource="{Binding Rows}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:RecordRow">
              <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:RecordCell">
                    <TextBlock Text="{Binding Text}" Width="{Binding Width}" Margin="4,0"
                               TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </DockPanel>

        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <globals:DesignGlobalsView DataContext="{Binding SettingsPane}" />
      </TabItem>

      <TabItem Header="Levels">
        <levels:LevelsView DataContext="{Binding LevelsPane}" />
      </TabItem>

      <TabItem Header="Events">
        <ev:EventEditorView DataContext="{Binding EventsPane}" />
      </TabItem>

      <TabItem Header="Items">
        <db:ItemDatabaseView DataContext="{Binding ItemsPane}" />
      </TabItem>

      <TabItem Header="Monsters">
        <db:MonsterDatabaseView DataContext="{Binding MonstersPane}" />
      </TabItem>

      <TabItem Header="Spells">
        <spells:SpellDatabaseView DataContext="{Binding SpellsPane}" />
      </TabItem>

      <TabItem Header="Special Abilities">
        <spells:SpecialAbilityDatabaseView DataContext="{Binding AbilitiesPane}" />
      </TabItem>

      <TabItem Header="Cross Reference">
        <cr:CrossReferenceView DataContext="{Binding CrossReferencePane}" />
      </TabItem>

    </TabControl>

  </DockPanel>

</Window>
