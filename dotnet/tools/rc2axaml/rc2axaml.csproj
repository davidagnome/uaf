<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One-shot .rc -> .axaml transpiler for Phase 5 (docs/PORTING-PLAN.md:8345).

    No project references. The MFC dialog grammar has nothing to do with the data model, and this
    tool is meant to be run a handful of times and then retired. The generated AXAML is raw
    material for hand refinement, not a build step.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Rc2Axaml</RootNamespace>
    <AssemblyName>rc2axaml</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
